{
  "_comment": [
    "Motif-pack type whitelist (design-system unification spec §2.2 — the",
    "~15-family list). A pack's six type roles may name ONLY these families.",
    "kind:self-hosted families have subsetted woff2 under assets/fonts/ and the",
    "renderer emits @font-face for them (core/01-fonts.css already declares the",
    "six default-role families; duplicates are harmless and deterministic).",
    "kind:system families are OS stacks — no files, no network, ever.",
    "A pack can NEVER introduce a network font: unknown families are rejected",
    "by tools/motif/validate-motif-pack.py (reason FONT-WHITELIST)."
  ],
  "families": {
    "Bowlby One": {
      "kind": "self-hosted",
      "fallback": ["Arial Black", "Arial Rounded MT Bold", "Impact", "sans-serif"],
      "faces": [
        { "file": "bowlby-one-latin-400-normal.woff2", "weight": 400, "style": "normal" }
      ]
    },
    "Alfa Slab One": {
      "kind": "self-hosted",
      "fallback": ["Bowlby One", "Arial Black", "Impact", "sans-serif"],
