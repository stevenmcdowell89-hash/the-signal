{
  // Workers Static Assets config for The Signal.
  //
  // Re-introduced (after the May-18 revert that broke the site) for one
  // specific reason: declaring `main` is what promotes the project from
  // "Worker with only static assets" to "Worker with a script", which is
  // required to add env vars and bindings (KV, etc.) for the push system.
  //
  // We deliberately do NOT set `html_handling` — leaving it at the default
  // (auto-trailing-slash) is what makes / resolve to index.html. Setting
  // it to "none" is what broke the site last time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-signal",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "_worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // KV bindings: Workers Builds treats this file as the source of truth.
  // Bindings set only via the dashboard get wiped on the next deploy, so
  // these have to live here. The id is the namespace's identifier (not a
  // secret) — visible in CF dashboard → Workers & Pages → KV.
  //
  // DAILY_CONFIG  — live, in-app-editable config (sources, profile, mutes,
  //                 fold threshold, enrichment toggle, spend cap, push).
  // DAILY_STATE   — the rendered home blob + the monthly spend ledger.
  //
  // Provision both before first deploy (see OPERATIONS.md → "The daily"):
  //   npx wrangler kv namespace create DAILY_CONFIG
  //   npx wrangler kv namespace create DAILY_STATE
  // then paste the returned ids over the REPLACE_ME placeholders below.
  "kv_namespaces": [
    { "binding": "SUBSCRIPTIONS", "id": "f528a67f5a1d4c739273680b9f046534" },
    { "binding": "DAILY_CONFIG", "id": "18caa91c18544fdfbce8bcdeee72582b" },
    { "binding": "DAILY_STATE", "id": "df2d4983ade441e0894e631cb7f8df84" }
  ],
  // D1 holds the triage engine's time-series data (per-source baselines, the
  // per-story movement log the weekly reads, the clustered item set, run log).
  // Provision once:
  //   npx wrangler d1 create the-signal-daily
  // then paste the returned database_id over the placeholder below. The schema
  // is created idempotently by the Worker on first run (no migrations to apply).
  "d1_databases": [
    {
      "binding": "DAILY_DB",
      "database_name": "the-signal-daily",
      "database_id": "ccf3614d-aa32-49b4-8e95-19ffa230b65f"
    }
  ],
  // Cron Trigger — every 10 min. Each tick refreshes all RSS/HN and re-attempts the
  // current Reddit batch's still-failing subs (≤6); a batch gets ~3 attempts over
  // ~30 min, then the cursor advances to the next ~6 — so a throttled sub gets a few
  // fresh shots at Reddit's shared-IP limit before we move on, and a full rotation is
  // still ~3h. See pipeline.js (redditBatch). The in-app cadence_hours is advisory.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
