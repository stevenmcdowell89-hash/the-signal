{
  // Cloudflare Workers Static Assets config for The Signal.
  //
  // Without this file, Workers Builds auto-generates a config with
  // `html_handling: "auto-trailing-slash"` (the default), which 301-redirects
  // /foo.html → /foo. That breaks service-worker caching: the SW intercepts
  // the original /foo.html request, follows the redirect on its own fetch,
  // and the cached response ends up keyed under /foo — so subsequent offline
  // navigations to /foo.html never match the cache.
  //
  // Setting html_handling to "none" makes Cloudflare serve /foo.html as-is,
  // no redirect. The SW then caches and matches under the same URL the
  // browser actually requests.
  //
  // not_found_handling: "none" returns a plain 404 for unknown paths instead
  // of falling back to index.html. The SW has its own offline-navigation
  // fallback to the cached archive, so we don't need Cloudflare doing it too.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-signal",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
