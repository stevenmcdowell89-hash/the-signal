{
  "version": 1,
  "_doc": "Lookup table mapping image-source domain → source type, per the 5-type taxonomy in references/spec/global.md image-integrity. Maintained alongside the editorial spec. Add a one-line mapping when a new source appears in research. The validate-research-bundle.py and check-image-diversity.sh scripts both read this file.",

  "types": {
    "press_kit":  "Official press kits and brand CDNs",
    "government": "Government / public-sector Flickr + media libraries",
    "archive":    "Museum / archive direct hosts",
    "news_cdn":   "News-agency / publication CDNs (editorial use cleared, or carried from prior published issues)",
    "wikimedia":  "Wikimedia Commons (supplement; capped per thresholds)"
  },

  "domains": {
    "commons.wikimedia.org":           "wikimedia",
    "upload.wikimedia.org":            "wikimedia",

    "lumiere-a.akamaihd.net":          "press_kit",
    "intermilan.bynder.com":           "press_kit",
    "gaming-cdn.com":                  "press_kit",
    "press.cloudflare.com":            "press_kit",
    "press.cloudflare.net":            "press_kit",
    "bethesda.net":                    "press_kit",
    "press.bethesda.net":              "press_kit",
    "nintendo.com":                    "press_kit",
    "press.disney.com":                "press_kit",
    "image.tmdb.org":                  "press_kit",

    "photojournal.jpl.nasa.gov":       "government",
    "images.nasa.gov":                 "government",
    "science.nasa.gov":                "government",
    "www.jpl.nasa.gov":                "government",
    "esa.int":                         "government",
    "www.esa.int":                     "government",
    "www.flickr.com/photos/number10gov":   "government",
    "www.flickr.com/photos/whitehouse":    "government",
    "www.flickr.com/photos/ukparliament":  "government",
    "www.flickr.com/photos/defenseimagery": "government",

    "iwm.org.uk":                      "archive",
    "media.iwm.org.uk":                "archive",
    "rafmuseum.org.uk":                "archive",
    "collections.rafmuseum.org.uk":    "archive",
    "britishmuseum.org":               "archive",
    "vam.ac.uk":                       "archive",
    "geograph.org.uk":                 "archive",
    "s0.geograph.org.uk":              "archive",
    "loc.gov":                         "archive",
    "wellcomecollection.org":          "archive",
    "awm.gov.au":                      "archive",

    "starwarsnewsnet.com":             "news_cdn",
    "www.starwarsnewsnet.com":         "news_cdn",
    "npr.brightspotcdn.com":           "news_cdn",
    "media-cldnry.s-nbcnews.com":      "news_cdn",
    "akm-img-a-in.tosshub.com":        "news_cdn",
    "news.cgtn.com":                   "news_cdn",
    "data2.nssmag.com":                "news_cdn",
    "content.presspage.com":           "news_cdn",
    "ichef.bbci.co.uk":                "news_cdn",
    "static.reuters.com":              "news_cdn",
    "cloudfront-us-east-2.images.arcpublishing.com": "news_cdn"
  },

  "ambiguous_domains": {
    "live.staticflickr.com": "Direct Flickr image host serves any user. Classify per the Flickr user (whitehouse, number10gov, ukparliament → government). When a researcher cites a live.staticflickr.com URL, the image_candidate entry MUST include an explicit source_type field — the validator cannot infer it from the URL."
  },

  "thresholds": {
    "single_domain_max_pct":   50,
    "wikimedia_max_pct":       30,
    "wikimedia_max_count":      4,
    "min_distinct_source_types": 3,
    "_doc": "single_domain_max_pct is the RT-5 hard fail. wikimedia_max_pct and wikimedia_max_count are tighter editorial guidance (the lower of the two wins). min_distinct_source_types enforces the 3-of-5 menu."
  }
}
